# Build context is this repo's own root (pnpm-lock.yaml lives there).
# ares-docs/ is vendored into this repo as a subdirectory (see that folder's own note) — it used
# to be a sibling module in the ares-asm monorepo; extracted here as-is, unchanged, so this
# Dockerfile needed no logic changes beyond dropping the old ares-ui/ path prefix.
FROM node:22-alpine AS build
RUN npm install -g pnpm@9
WORKDIR /workspace
COPY pnpm-lock.yaml package.json ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec vite build

# Current-version-only docs, bundled alongside the SPA at /docs/ (see nginx.conf's plain
# static-file fallthrough and ares-docs/docusaurus.config.ts's DOCS_BUILD_MODE=local). The
# full, multi-version history lives on the separate public docs.martecyber.com site instead —
# see ares-docs/README.md.
FROM node:22-alpine AS docs-build
WORKDIR /workspace/ares-docs
COPY ares-docs/package.json ares-docs/package-lock.json ./
RUN npm install
COPY ares-docs/ ./
RUN DOCS_BUILD_MODE=local npm run build

FROM nginx:1.27-alpine
COPY --from=build /workspace/dist/ /usr/share/nginx/html/
COPY --from=docs-build /workspace/ares-docs/build/ /usr/share/nginx/html/docs/
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.d/05-api-upstream.sh /docker-entrypoint.d/05-api-upstream.sh
COPY docker-entrypoint.d/06-sentry-config.sh /docker-entrypoint.d/06-sentry-config.sh
COPY docker-entrypoint.d/10-enable-ssl.sh /docker-entrypoint.d/10-enable-ssl.sh
RUN chmod +x /docker-entrypoint.d/05-api-upstream.sh /docker-entrypoint.d/06-sentry-config.sh /docker-entrypoint.d/10-enable-ssl.sh
EXPOSE 80 443
